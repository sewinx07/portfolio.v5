DATABASE_URL="file:./dev.db"

# Session signing secret — set a long random string.
AUTH_SECRET=""

# Admin bootstrap credentials (used only by prisma/seed.mjs).
ADMIN_EMAIL="admin@tahagmir.com"
ADMIN_PASSWORD=""

# Optional AI provider (OpenAI-compatible). Leave blank to use the offline assistant.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Public site base URL for SEO (sitemap, canonical, OG).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"