# PostgreSQL (Neon recommended for Vercel). Pooled URL for runtime, direct URL for migrations.
# Create a Neon project (console.neon.tech), then use its "Pooled connection" as
# DATABASE_URL and the "Direct connection" as DIRECT_URL.
# Add &connect_timeout=15 — Neon free-tier computes auto-suspend after ~5 min idle,
# and the first query after idle pays a ~1-2s cold start that can exceed Prisma's default 5s.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Session signing secret — set a long random string.
AUTH_SECRET=""

# Admin bootstrap credentials (used only by prisma/seed.mjs).
ADMIN_EMAIL="admin@tahagmir.com"
ADMIN_PASSWORD=""

# Optional AI provider (OpenAI-compatible). Leave blank to use the offline assistant.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Public site base URL for SEO (sitemap, canonical, OG).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"